{
  "schemaVersion": 2,
  "status": "draft-not-executable",
  "note": "All numeric values are editable initial examples. GPT/Gemini model names are discussion candidates, not account availability guarantees. Claude model strings keep the user-provided azuer_ai/... spelling. Thresholds belong to each entry: the same model in SA1 and SA2 may use different values (SA1 gpt-6.1-sol 50, SA2 gpt-6.1-sol 70; editable examples, not global company/personal thresholds). SD2 is enabled with models [] to show defaultModel use; QA is a disabled, editable expansion example (not an approved team member) and cannot start via defaultModel. Role IDs are open: PM/SA1/SA2/SD1/SD2/PG are initial examples, not an allowed list. Field names are draft and do not imply a runtime exists. A negative value (e.g. -1) means keep working when low or unknown and wait for quota only on a real limit signal, never switching. metric/value support beyond this example is not implemented and is left to technical design.",
  "decisions": {
    "ownership": "pending-user-decision"
  },
  "coordination": {
    "pmRoleId": "PM",
    "userContact": "pm-only",
    "teamSize": "pm-selects-from-enabled-roles",
    "createMembersOnDemand": true,
    "maxReviewRoundsPerIssue": 3,
    "onUnresolvedIssue": "pm-relays-to-user",
    "onUserDecisionPending": "pause-dependent-work",
    "preserveUserFocus": true,
    "workflow": "task-dependent-optional"
  },
  "roleExpansion": {
    "proposedBy": "pm",
    "addDuringTaskRequiresUserApproval": true,
    "appliesToNewRoleAndExtraMember": true,
    "approveBeforeLaunch": true,
    "pendingIsNotApproval": true,
    "modifiedProposalRequiresReapproval": true,
    "applyOnlyApprovedScope": true,
    "onRoleIdConflict": "stop-and-report",
    "approvalScope": "team-effective-config",
    "persistToSharedConfigRequiresExplicitApproval": true,
    "retryMustNotExceedApprovedCount": true
  },
  "reporting": {
    "mode": "role-pushes-to-pm",
    "transport": "local-outbox-then-sender",
    "deliveryStates": [
      "queued",
      "sent",
      "received"
    ],
    "whenPmBusy": "queue-and-coalesce",
    "maxSendRetries": 3,
    "defaultDeadlines": {
      "ackSeconds": 60,
      "progressSeconds": 300,
      "hardNoReportSeconds": 900
    },
    "heartbeatResetsHardDeadline": false,
    "onDeadlineExceeded": "bounded-diagnosis-once",
    "notifyPermission": "minimal-allow-for-fixed-wrapper"
  },
  "usage": {
    "pollIntervalSeconds": 60,
    "maxObservationAgeSeconds": 120,
    "taskEstimatedBudgetUsd": null,
    "monthlyEstimatedBudgetUsd": null,
    "allowExtraCredits": false,
    "allowPersonalApiKeyFallback": false
  },
  "providers": {
    "claude": {
      "enabled": true,
      "cli": "claude",
      "authentication": "existing-cli-company-configuration",
      "quotaPool": "company-claude",
      "usageSources": [
        "session-statusline",
        "optional-company-quota-adapter"
      ]
    },
    "codex": {
      "enabled": true,
      "cli": "codex",
      "authentication": "chatgpt-subscription",
      "quotaPool": "personal-codex",
      "usageSources": [
        "app-server-account-rate-limits"
      ]
    },
    "gemini": {
      "enabled": false,
      "cli": "gemini",
      "authentication": "google-subscription",
      "quotaPool": "personal-gemini",
      "usageSources": [
        "unverified-adapter"
      ]
    }
  },
  "defaultModel": {
    "provider": "claude",
    "model": "azuer_ai/sonnet-5-5[1m]",
    "enabled": true,
    "remainingThreshold": {
      "metric": "quotaRemainingPercent",
      "value": 0
    }
  },
