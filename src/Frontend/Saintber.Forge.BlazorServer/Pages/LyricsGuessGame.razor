@page "/lyrics-guess-game"
@using Saintber.Forge.Tools.LyricsGuessGame.Abstractions
@using Saintber.Forge.Tools.LyricsGuessGame.Abstractions.Exceptions
@using Saintber.Forge.Tools.LyricsGuessGame.Abstractions.Models
@using Saintber.Forge.Tools.LyricsGuessGame.BLL.Config
@using Saintber.Forge.BlazorServer.Components
@inject ILyricsGuessGameService GameService
@inject LyricsGuessGameConfig Config

<h1>Lyrics Guess Game</h1>

<div class="toolbar">
    <button class="btn btn-primary" @onclick="ShowPlaylistInput">輸入歌單</button>
    <select class="form-select d-inline-block ms-2" style="width: 320px;" value="@SelectedModelId" @onchange="HandleModelChanged">
        @foreach (var model in AvailableModels)
        {
            <option value="@model.ModelId">@model.DisplayName</option>
        }
    </select>
    @if (GameState.IsPlaylistParsed)
    {
        <button class="btn btn-secondary" @onclick="ShowPlaylistView">查看歌單</button>
    }
</div>

<PlaylistInputDialog Visible="IsInputDialogVisible" OnConfirm="HandlePlaylistConfirmAsync" OnCancel="HidePlaylistInput" />
<PlaylistViewDialog Visible="IsViewDialogVisible" Songs="GameState.Songs" OnClose="HidePlaylistView" />

@if (IsResetConfirmVisible)
{
    <div class="alert alert-warning mt-2">
        <p>目前遊戲進行中，重新輸入歌單會清空目前進度，是否繼續？</p>
        <button class="btn btn-danger" @onclick="ConfirmResetAndShowInput">確認覆蓋</button>
        <button class="btn btn-outline-secondary ms-2" @onclick="CancelReset">取消</button>
    </div>
}

@if (IsParsing)
{
    <p>正在解析歌單...</p>
}

@if (IsLoadingLyrics)
{
    <p>正在出題...</p>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="text-danger">@ErrorMessage</p>
}

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <p>@StatusMessage</p>
}

@if (GameState.CurrentQuestion != null)
{
    <div class="question-card">
        <h3>猜歌題目</h3>
        <pre>@GameState.CurrentQuestion.LyricsSnippet</pre>
        <div class="mt-2">
            <input class="form-control"
                   placeholder="請輸入歌名"
                   @bind="AnswerInput"
                   @bind:event="oninput" />
        </div>
        <div class="mt-2">
            <button class="btn btn-primary" @onclick="SubmitAnswerFromInputAsync">提交答案</button>
            <button class="btn btn-warning ms-2" @onclick="RevealAnswerAsync">公佈答案</button>
            @if (CanRetryValidation)
            {
                <button class="btn btn-outline-secondary ms-2" @onclick="RetryValidationAsync">重試</button>
            }
        </div>
    </div>
}

@if (IsGameEnded)
{
    <div class="mt-3">
        <p>遊戲結束</p>
        <button class="btn btn-success" @onclick="RestartCurrentPlaylistAsync">重新開始本歌單</button>
        <button class="btn btn-outline-primary ms-2" @onclick="ShowPlaylistInput">重新輸入歌單</button>
    </div>
}

@code {
    public GameState GameState { get; private set; } = new();

    public bool IsParsing { get; private set; }

    public bool IsLoadingLyrics { get; private set; }

    public string? ErrorMessage { get; private set; }

    public string? StatusMessage { get; private set; }

    public bool IsInputDialogVisible { get; private set; }

    public bool IsViewDialogVisible { get; private set; }

    public string SelectedModelId { get; private set; } = string.Empty;

    public string AnswerInput { get; private set; } = string.Empty;

    public bool CanRetryValidation { get; private set; }

    public bool IsGameEnded { get; private set; }

    public List<AIModelConfig> AvailableModels { get; private set; } = new();

    public bool IsResetConfirmVisible { get; private set; }

    protected override void OnInitialized()
    {
        AvailableModels = GameService.GetAvailableModels();
        SelectedModelId = string.Empty;

        try
        {
            SelectedModelId = GameService.GetDefaultModelId();
        }
        catch (InvalidOperationException)
        {
            SelectedModelId = AvailableModels.FirstOrDefault()?.ModelId ?? string.Empty;
        }

        GameState.SelectedModelId = SelectedModelId;
    }

    public Task HandlePlaylistConfirmAsync(string playlistText)
    {
        return HandlePlaylistConfirmInternalAsync(playlistText);
    }

    public Task StartNextQuestionAsync()
    {
        return StartNextQuestionInternalAsync();
    }

    public Task SubmitAnswerAsync(string answer)
    {
        return SubmitAnswerInternalAsync(answer);
    }

    public Task RevealAnswerAsync()
    {
        return RevealAnswerInternalAsync();
    }

    private void ShowPlaylistInput()
    {
        if (GameState.IsGameActive || GameState.IsPlaylistParsed)
        {
            IsResetConfirmVisible = true;
            return;
        }

        IsInputDialogVisible = true;
        ErrorMessage = null;
        StatusMessage = null;
    }

    private Task ConfirmResetAndShowInput()
    {
        ResetGameStateForNewPlaylist();
        IsResetConfirmVisible = false;
        IsInputDialogVisible = true;
        return Task.CompletedTask;
    }

    private Task CancelReset()
    {
        IsResetConfirmVisible = false;
        return Task.CompletedTask;
    }

    private Task HidePlaylistInput()
    {
        IsInputDialogVisible = false;
        return Task.CompletedTask;
    }

    private void ShowPlaylistView()
    {
        IsViewDialogVisible = true;
    }

    private Task HidePlaylistView()
    {
        IsViewDialogVisible = false;
        return Task.CompletedTask;
    }

    private Task HandleModelChanged(ChangeEventArgs args)
    {
        var modelId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(modelId))
        {
            return Task.CompletedTask;
        }

        SelectedModelId = modelId;
        GameState.SelectedModelId = modelId;
        StatusMessage = $"已切換模型：{AvailableModels.FirstOrDefault(m => m.ModelId == modelId)?.DisplayName ?? modelId}";
        ErrorMessage = null;
        return Task.CompletedTask;
    }

    private async Task HandlePlaylistConfirmInternalAsync(string playlistText)
    {
        ResetGameStateForNewPlaylist();
        ErrorMessage = null;
        StatusMessage = null;
        IsParsing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var songs = await GameService.ParsePlaylistBasicInfoAsync(playlistText, SelectedModelId);

            GameState = new GameState
            {
                Songs = songs,
                IsPlaylistParsed = true,
                IsGameActive = false,
                SelectedModelId = SelectedModelId
            };

            IsGameEnded = false;

            IsInputDialogVisible = false;
            IsResetConfirmVisible = false;
            await StartNextQuestionInternalAsync();
        }
        catch (AIServiceException)
        {
            if (TryFallbackToDefaultModel())
            {
                ErrorMessage = "所選模型暫時無法使用，已自動切換至預設模型，請重試";
            }
            else
            {
                ErrorMessage = "歌單解析失敗，請重試";
            }
        }
        catch
        {
            ErrorMessage = "歌單解析失敗，請重試";
        }
        finally
        {
            IsParsing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartNextQuestionInternalAsync()
    {
        ErrorMessage = null;
        StatusMessage = null;
        IsLoadingLyrics = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var question = await GameService.GenerateRandomQuestionAsync(
                GameState,
                SelectedModelId,
                Math.Max(1, Config.InitializationRetryCount));

            if (question == null)
            {
                var remainingCount = GameState.Songs
                    .Select((song, index) => new { song, index })
                    .Count(x => x.song.CanGenerateQuestion && !GameState.UsedSongIndices.Contains(x.index));

                GameState.IsGameActive = false;
                GameState.CurrentQuestion = null;

                if (GameState.UsedSongIndices.Count >= GameState.Songs.Count)
                {
                    StatusMessage = "遊戲結束！所有歌曲已完成";
                    IsGameEnded = true;
                }
                else if (remainingCount == 0)
                {
                    ErrorMessage = "AI 服務暫時無法提供歌詞，請更換歌單或稍後再試";
                }

                return;
            }

            GameState.CurrentQuestion = question;
            GameState.IsGameActive = true;
            IsGameEnded = false;
        }
        catch (AIServiceException)
        {
            if (TryFallbackToDefaultModel())
            {
                ErrorMessage = "所選模型暫時無法使用，已自動切換至預設模型，請重試";
            }
            else
            {
                ErrorMessage = "歌詞節錄失敗，請稍後再試";
            }
        }
        catch
        {
            ErrorMessage = "歌詞節錄失敗，請稍後再試";
        }
        finally
        {
            IsLoadingLyrics = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SubmitAnswerFromInputAsync()
    {
        await SubmitAnswerInternalAsync(AnswerInput);
    }

    private async Task RetryValidationAsync()
    {
        await SubmitAnswerInternalAsync(AnswerInput);
    }

    private async Task SubmitAnswerInternalAsync(string answer)
    {
        ErrorMessage = null;
        StatusMessage = null;
        CanRetryValidation = false;

        if (GameState.CurrentQuestion == null)
        {
            ErrorMessage = "目前沒有可作答的題目";
            return;
        }

        if (string.IsNullOrWhiteSpace(answer))
        {
            ErrorMessage = "請輸入答案";
            return;
        }

        try
        {
            var currentQuestion = GameState.CurrentQuestion;
            var result = await GameService.ValidateAnswerAsync(
                answer,
                currentQuestion.CorrectSongTitle,
                SelectedModelId);

            StatusMessage = result.SimilarityType switch
            {
                SimilarityType.Exact => "答對了!",
                SimilarityType.SimilarButWrong => "風格很像但不是",
                SimilarityType.AlmostCorrect => "只差一個字",
                _ => "不對喔！"
            };

            AnswerInput = string.Empty;

            if (result.IsCorrect)
            {
                currentQuestion.QuestionState = QuestionState.AnsweredCorrectly;
                GameState.UsedSongIndices.Add(currentQuestion.SongIndex);
                await StartNextQuestionInternalAsync();
                return;
            }

            currentQuestion.QuestionState = QuestionState.Unanswered;
        }
        catch (AIServiceException)
        {
            if (TryFallbackToDefaultModel())
            {
                ErrorMessage = "所選模型暫時無法使用，已自動切換至預設模型，請重試";
            }
            else
            {
                ErrorMessage = "答案驗證失敗，請重試";
            }

            CanRetryValidation = true;
        }
        catch
        {
            ErrorMessage = "答案驗證失敗，請重試";
            CanRetryValidation = true;
        }
    }

    private async Task RevealAnswerInternalAsync()
    {
        ErrorMessage = null;
        CanRetryValidation = false;

        if (GameState.CurrentQuestion == null)
        {
            return;
        }

        var currentQuestion = GameState.CurrentQuestion;
        currentQuestion.QuestionState = QuestionState.RevealedAnswer;
        GameState.UsedSongIndices.Add(currentQuestion.SongIndex);
        StatusMessage = $"答案：{currentQuestion.CorrectSongTitle} - {currentQuestion.CorrectArtist}";

        await InvokeAsync(StateHasChanged);
        await Task.Delay(1200);
        await StartNextQuestionInternalAsync();
    }

    private async Task RestartCurrentPlaylistAsync()
    {
        ErrorMessage = null;
        StatusMessage = null;
        CanRetryValidation = false;
        AnswerInput = string.Empty;
        IsGameEnded = false;

        GameState.CurrentQuestion = null;
        GameState.UsedSongIndices.Clear();
        GameState.IsGameActive = false;

        await StartNextQuestionInternalAsync();
    }

    private bool TryFallbackToDefaultModel()
    {
        var fallbackModelId = AvailableModels.FirstOrDefault(m => m.IsDefault)?.ModelId;
        if (string.IsNullOrWhiteSpace(fallbackModelId) || fallbackModelId == SelectedModelId)
        {
            return false;
        }

        SelectedModelId = fallbackModelId;
        GameState.SelectedModelId = fallbackModelId;
        return true;
    }

    private void ResetGameStateForNewPlaylist()
    {
        GameState.Songs.Clear();
        GameState.CurrentQuestion = null;
        GameState.UsedSongIndices.Clear();
        GameState.IsPlaylistParsed = false;
        GameState.IsGameActive = false;
        GameState.SelectedModelId = SelectedModelId;

        IsGameEnded = false;
        CanRetryValidation = false;
        AnswerInput = string.Empty;
        ErrorMessage = null;
        StatusMessage = null;
    }
}
