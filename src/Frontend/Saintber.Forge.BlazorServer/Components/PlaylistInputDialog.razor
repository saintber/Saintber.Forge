@using Microsoft.AspNetCore.Components

@if (Visible)
{
    <div class="dialog-backdrop">
        <div class="dialog">
            <h3>輸入歌單</h3>
            <textarea @bind="playlistText" rows="6" class="playlist-input"></textarea>
            <div class="dialog-actions">
                <button class="btn btn-secondary" @onclick="OnCancelClicked">取消</button>
                <button class="btn btn-primary" @onclick="OnConfirmClicked">確認</button>
            </div>
        </div>
    </div>
}

@code {
    private string playlistText = string.Empty;

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<string> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task OnConfirmClicked()
    {
        if (OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync(playlistText);
        }
    }

    private async Task OnCancelClicked()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}
