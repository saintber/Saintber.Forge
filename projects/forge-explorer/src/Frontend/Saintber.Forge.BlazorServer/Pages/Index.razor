@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Saintber.Forge.BlazorServer.Components
@using Saintber.Forge.BlazorServer.Services
@using Saintber.Forge.Persistence.EF.Postgres.Entities
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IToolRegistrationService ToolRegistrationService
@inject IUserIdentityService UserIdentityService

<PageTitle>Portal Home</PageTitle>

<h1>功能入口</h1>

@if (!string.IsNullOrEmpty(displayName))
{
    <p>歡迎，@displayName</p>
}

@if (isLoading)
{
    <p>載入中...</p>
}
else if (visibleTools.Count == 0)
{
    <p>目前無可用功能</p>
}
else
{
    <div class="tool-grid">
        @foreach (var tool in visibleTools)
        {
            <ToolCard Tool="@tool" />
        }
    </div>
}

@code {
    private List<ToolRegistration> visibleTools = new();
    private bool isLoading = true;
    private string? displayName;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var isAuthenticated = user.Identity?.IsAuthenticated ?? false;

            if (isAuthenticated)
            {
                // Get user info
                var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value 
                    ?? user.FindFirst("oid")?.Value 
                    ?? user.FindFirst("sub")?.Value;
                displayName = user.FindFirst(ClaimTypes.Name)?.Value 
                    ?? user.FindFirst("name")?.Value;
                var email = user.FindFirst(ClaimTypes.Email)?.Value 
                    ?? user.FindFirst("preferred_username")?.Value;

                // Update last login time
                if (!string.IsNullOrEmpty(userId))
                {
                    await UserIdentityService.UpdateLastLoginAsync(userId, displayName, email);
                }

                // Get all tools (including protected ones)
                visibleTools = await ToolRegistrationService.GetAllToolsAsync();
            }
            else
            {
                // Get only public tools
                visibleTools = await ToolRegistrationService.GetPublicToolsAsync();
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}
